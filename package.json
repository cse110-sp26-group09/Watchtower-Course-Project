{
  "name": "watchtower",
  "version": "0.1.0",
  "private": true,
  "description": "WatchTower - a lightweight observability web application that captures and displays user events, JavaScript errors, performance metrics, and feedback through a real-time dashboard.",
  "license": "UNLICENSED",
  "scripts": {
    "config:clerk": "node scripts/generate-clerk-config.js",
    "start": "npm run config:clerk && node src/backend/server.js",
    "test": "npm run test:unit",
    "test:unit": "jest tests/unit",
    "test:e2e": "playwright test tests/e2e",
    "docs:js": "jsdoc src/backend src/sdk src/shared -r -d docs/api"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "jest": "^30.4.2",
    "jsdoc": "^4.0.4"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.108.2",
    "dotenv": "^17.4.2",
    "googleapis": "^173.0.0",
    "jose": "^6.2.3",
    "nodemailer": "^8.0.10",
    "pg": "^8.21.0"
  }
}
