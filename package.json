    "test:e2e": "playwright test tests/e2e",
    "docs:js": "jsdoc src -r -d docs/api"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "jest": "^30.4.2",
    "jsdoc": "^4.0.4"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.106.2",
    "better-sqlite3": "^12.10.0",
    "dotenv": "^17.4.2",
    "pg": "^8.21.0"
