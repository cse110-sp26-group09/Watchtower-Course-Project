# WatchTower environment variables
# Copy this file to .env for local development:
#   cp .env.example .env
#
# On Render: add CLERK_PUBLISHABLE_KEY under Environment in the dashboard.
# The start script runs `npm run config:clerk` to generate clerk-config.js at boot.

# Clerk publishable key (frontend-safe — safe to expose in the browser).
# Find it in the Clerk dashboard: Configure → API Keys → Publishable key.
# Use pk_test_... for development, pk_live_... for production.
# The backend also derives the Clerk JWT issuer/JWKS from this key to verify
# dashboard session tokens (no Clerk SECRET key is required for verification).
CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_ME

# Optional: explicit Clerk JWT issuer (Frontend API origin), e.g.
# https://your-app.clerk.accounts.dev. Only needed if it cannot be derived from
# CLERK_PUBLISHABLE_KEY. When neither is a real key, the server disables token
# verification and trusts the X-Clerk-User-Id header (prototype/test mode).
# CLERK_JWT_ISSUER=

# Optional: force-trust the X-Clerk-User-Id header even when token verification
# is configured (e.g. header-only API tests against a real-key server). Insecure.
# WATCHTOWER_TRUST_USER_HEADER=false

# Optional (TEMPORARY prototype/demo only): default owner for unauthenticated
# external SDK events. The public GitHub Pages test app has no Clerk session, so
# its events would otherwise be stored with user_id = NULL and never show up on
# any scoped dashboard. When this is set, POST /api/events and /api/beacon
# attribute anonymous external events to this Clerk user id (the demo owner), so
# they appear on that owner's dashboard. Authenticated dashboard requests still
# win and override this. Leave UNSET in CI/local tests. Long-term, replace this
# single-owner mapping with a project/app key ownership system. Set the value to
# the demo owner's Clerk user id (looks like user_xxxx;) — do NOT hard-code it in
# source. On Render, add it under Environment.
# DEFAULT_INGEST_OWNER_USER_ID=

GMAIL_ADDRESS=watchtoweralerts@gmail.com
GMAIL_CLIENT_ID=your_client_id_here
GMAIL_CLIENT_SECRET=your_client_secret_here
GMAIL_REFRESH_TOKEN=your_refresh_token_here
ERROR_ALERT_THRESHOLD=5
ERROR_ALERT_WINDOW_MS=300000
ALERT_COOLDOWN_MS=900000

# Future alert-recipient rollout:
# CLERK_SECRET_KEY=your_clerk_secret_key_here
# CLERK_ALERT_RECIPIENT_CACHE_MS=300000


# Supabase configuration

SUPABASE_URL=your_supabase_url_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# WatchTower uses its own tables when Supabase credentials are configured.
# Event table defaults to prototype3_events; users table defaults to app_users.
# SUPABASE_P3_EVENTS_TABLE=prototype3_events
# SUPABASE_P3_USERS_TABLE=app_users

# Optional: only allow browser telemetry from these comma-separated origins.
# Leave unset or use * for local prototype work.
# CORS_ALLOWED_ORIGINS=*

# Optional: active session window used by WatchTower stats.
ACTIVE_USER_WINDOW_MS=30000

# Optional: maximum number of events retained in the working set (in-memory cap
# and prune target). Defaults to 10000.
# MAX_EVENTS=10000

# Optional: window (ms) for the dashboard "active issues" error count. Defaults
# to 24h. Set 0 to count all stored errors.
# ERROR_WINDOW_MS=86400000

# Optional: server port (Render sets PORT automatically)
# PORT=3000

# Optional: deployment environment label. Render/Node hosts usually set this;
# WatchTower does not require it for local development.
# NODE_ENV=development
